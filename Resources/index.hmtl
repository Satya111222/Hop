<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hop</title>
<style>
:root{--bg:#000;--fg:#fff;--dim:rgba(255,255,255,.5);--line:rgba(255,255,255,.14);--card:rgba(255,255,255,.05);--grid:rgba(255,255,255,.06);--red:#e5312b;--green:#34c759;--blue:#0a84ff;--orange:#ff9f0a;--yellow:#ffd60a;--gray:#8e8e93;--purple:#bf5af2;--pink:#ff375f;--teal:#64d2ff}
:root[data-theme=light]{--bg:#fff;--fg:#000;--dim:rgba(0,0,0,.5);--line:rgba(0,0,0,.14);--card:rgba(0,0,0,.05);--grid:rgba(0,0,0,.06)}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--fg);font-family:ui-monospace,"SF Mono","Cascadia Mono",Consolas,Menlo,monospace;font-size:14px;min-height:100vh;
background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px}
.wrap{max-width:760px;margin:0 auto;padding:28px 18px 60px}
header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}
h1{font-size:36px;margin:0 0 4px}
.sub{color:var(--dim);font-size:12px}
.row{display:flex;align-items:center;gap:8px}
.tag{font-size:10px;font-weight:700;padding:3px 8px;border-radius:99px;background:color-mix(in srgb,var(--c,var(--gray)) 18%,transparent);color:var(--c,var(--gray))}
.round{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--bg);color:var(--fg);font:inherit;font-size:16px;cursor:pointer;display:grid;place-items:center}
.round:hover{border-color:var(--fg)}
.round.red{background:var(--red);border-color:var(--red);color:#fff}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:12px}
.drop{border:1.5px dashed var(--line);text-align:center;padding:34px 16px;transition:border-color .15s,background .15s}
.drop.over{border-color:var(--red);background:color-mix(in srgb,var(--red) 10%,transparent)}
.drop b{display:block;font-size:16px;margin-bottom:6px}
.btn{margin-top:14px;background:var(--red);color:#fff;border:0;border-radius:99px;padding:12px 22px;font:inherit;font-weight:700;cursor:pointer}
h2{font-size:13px;margin:26px 0 10px;color:var(--dim);font-weight:700}
.name{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.bar{height:6px;border-radius:99px;background:color-mix(in srgb,var(--fg) 10%,transparent);margin:10px 0 8px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--red);border-radius:99px;transition:width .2s}
.bar i.ok{background:var(--green)}
.info{font-size:11px;color:var(--dim)}
.grow{flex:1;min-width:0}
.file{display:flex;align-items:center;gap:12px}
.file .round{width:36px;height:36px;font-size:14px;text-decoration:none}
.empty{color:var(--dim);font-size:12px}
#pinov{position:fixed;inset:0;background:color-mix(in srgb,var(--bg) 85%,transparent);display:none;place-items:center;z-index:9}
#pinov .card{width:min(340px,90vw);background:var(--bg)}
#pinov input{width:100%;font:inherit;font-size:24px;letter-spacing:.3em;text-align:center;padding:12px;margin-top:12px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--fg)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div><h1>hop</h1><div class="sub">iPad and PC file transfer</div></div>
    <div class="row"><span id="status" class="tag">CONNECTING</span><button class="round" id="theme" title="Toggle theme">&#9680;</button></div>
  </header>

  <div class="card drop" id="drop">
    <b>Drop files here to send them to the iPad</b>
    <span class="sub">Large files go in resumable chunks, one file at a time.</span><br>
    <button class="btn" id="pick">Choose files</button>
    <input type="file" id="file" multiple hidden>
  </div>

  <div id="queue"></div>

  <div class="row" style="justify-content:space-between"><h2>On this iPad</h2><button class="round" id="refresh" title="Refresh">&#8635;</button></div>
  <div id="files"></div>
</div>

<div id="pinov"><div class="card"><b>Enter the PIN shown on the iPad</b><input id="pininput" inputmode="numeric" autocomplete="off" maxlength="8"></div></div>

<script>
const CHUNK = 4 * 1024 * 1024;
const $ = s => document.querySelector(s);
const sleep = ms => new Promise(r => setTimeout(r, ms));
let PIN = '';
try { PIN = sessionStorage.getItem('pin') || ''; } catch (e) {}

// theme
(function () {
  let t = 'dark';
  try { t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'); } catch (e) {}
  document.documentElement.dataset.theme = t;
  $('#theme').onclick = () => {
    t = t === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem('theme', t); } catch (e) {}
  };
})();

const fmtB = n => { const u = ['B', 'KB', 'MB', 'GB', 'TB']; let i = 0; while (n >= 1024 && i < 4) { n /= 1024; i++; } return (i ? n.toFixed(n < 10 ? 2 : 1) : n) + ' ' + u[i]; };
const fmtT = s => { if (!isFinite(s) || s < 0) return '--'; s = Math.round(s); return s < 60 ? s + 's' : s < 3600 ? Math.floor(s / 60) + 'm ' + (s % 60) + 's' : Math.floor(s / 3600) + 'h ' + Math.floor(s % 3600 / 60) + 'm'; };
const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const qs = o => new URLSearchParams(o).toString();
const extColor = e => ({ jpg: 'purple', jpeg: 'purple', png: 'purple', heic: 'purple', gif: 'purple', webp: 'purple', mp4: 'pink', mov: 'pink', mkv: 'pink', mp3: 'teal', m4a: 'teal', wav: 'teal', pdf: 'orange', doc: 'orange', docx: 'orange', txt: 'orange', xlsx: 'orange', pptx: 'orange', zip: 'yellow', rar: 'yellow', '7z': 'yellow', ipa: 'yellow' }[e] || 'gray');

function api(path, opts = {}) {
  opts.headers = Object.assign({ 'X-Pin': PIN }, opts.headers || {});
  return fetch(path, opts);
}

function askPin() {
  return new Promise(resolve => {
    const ov = $('#pinov'), inp = $('#pininput');
    ov.style.display = 'grid'; inp.value = ''; inp.focus();
    inp.onkeydown = e => {
      if (e.key === 'Enter' && inp.value) {
        PIN = inp.value.trim();
        try { sessionStorage.setItem('pin', PIN); } catch (x) {}
        ov.style.display = 'none';
        resolve();
      }
    };
  });
}

function setStatus(ok, text) {
  const s = $('#status');
  s.textContent = text; s.style.setProperty('--c', ok ? 'var(--green)' : 'var(--red)');
}

// ---------- uploads ----------
const queue = []; let busy = false;

function makeRow(f) {
  const el = document.createElement('div');
  el.className = 'card';
  el.innerHTML = '<div class="row"><span class="tag" style="--c:var(--blue)">TO IPAD</span><span class="tag st" style="--c:var(--gray)">QUEUED</span><span class="grow"></span><b class="pct">0%</b></div>' +
    '<div class="name" style="margin-top:10px">' + esc(f.name) + '</div><div class="bar"><i></i></div><div class="info">' + fmtB(f.size) + '</div>';
  $('#queue').prepend(el);
  return { el, f, t0: 0, lastT: 0, lastB: 0, speed: 0 };
}

function paint(row, bytes, state) {
  const f = row.f, pct = f.size ? Math.min(100, bytes / f.size * 100) : 100, now = performance.now();
  if (!row.lastT) { row.lastT = now; row.lastB = bytes; }
  if (now - row.lastT > 400) {
    const inst = (bytes - row.lastB) / ((now - row.lastT) / 1000);
    row.speed = row.speed ? row.speed * 0.6 + inst * 0.4 : inst;
    row.lastT = now; row.lastB = bytes;
  }
  row.el.querySelector('.bar i').style.width = pct + '%';
  row.el.querySelector('.pct').textContent = Math.floor(pct) + '%';
  let info = fmtB(Math.min(bytes, f.size)) + ' / ' + fmtB(f.size);
  if (!state && row.speed > 1) info += '   ' + fmtB(row.speed) + '/s   ' + fmtT((f.size - bytes) / row.speed) + ' left';
  const st = row.el.querySelector('.st');
  if (state === 'done') { st.textContent = 'DONE'; st.style.setProperty('--c', 'var(--green)'); row.el.querySelector('.bar i').classList.add('ok'); info = fmtB(f.size) + ' sent'; }
  else if (state === 'fail') { st.textContent = 'FAILED'; st.style.setProperty('--c', 'var(--red)'); }
  else if (state === 'retry') { st.textContent = 'RETRYING'; st.style.setProperty('--c', 'var(--orange)'); }
  else { st.textContent = 'LIVE'; st.style.setProperty('--c', 'var(--yellow)'); }
  row.el.querySelector('.info').textContent = info;
}

function fileId(f) {
  const s = f.name + '|' + f.size + '|' + f.lastModified; let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
  return 'u' + (h >>> 0).toString(36) + f.size.toString(36);
}

function xhrPut(url, blob, onprog) {
  return new Promise((res, rej) => {
    const x = new XMLHttpRequest();
    x.open('PUT', url);
    x.setRequestHeader('X-Pin', PIN);
    x.upload.onprogress = e => onprog(e.loaded);
    x.onload = () => res(x);
    x.onerror = () => rej(new Error('network error'));
    x.ontimeout = () => rej(new Error('timeout'));
    x.timeout = 120000;
    x.send(blob);
  });
}

async function sendChunk(f, id, off, row) {
  const end = Math.min(off + CHUNK, f.size);
  const url = '/api/upload?' + qs({ id, name: f.name, offset: off, total: f.size });
  const blob = f.slice(off, end);
  let tries = 0;
  for (;;) {
    try {
      const x = await xhrPut(url, blob, loaded => paint(row, off + loaded));
      if (x.status === 401) { await askPin(); continue; }
      if (x.status === 409) return JSON.parse(x.responseText).received; // server has less, resume from there
      if (x.status !== 200) throw new Error('server returned ' + x.status);
      return end;
    } catch (e) {
      if (++tries > 6) throw e;
      paint(row, off, 'retry');
      await sleep(Math.min(1000 * tries, 5000));
    }
  }
}

async function upload(row) {
  const f = row.f, id = fileId(f); let off = 0;
  try {
    const r = await (await api('/api/upload/status?' + qs({ id }))).json();
    if (r.received > 0 && r.received <= f.size) off = r.received;
  } catch (e) {}
  row.t0 = performance.now();
  paint(row, off);
  while (off < f.size) off = await sendChunk(f, id, off, row);
  let tries = 0;
  for (;;) {
    try {
      const r = await api('/api/upload/finish?' + qs({ id, name: f.name, total: f.size }), { method: 'POST' });
      if (r.status === 401) { await askPin(); continue; }
      if (r.status !== 200) throw new Error('could not finish (' + r.status + ')');
      break;
    } catch (e) { if (++tries > 4) throw e; await sleep(1000); }
  }
  paint(row, f.size, 'done');
}

async function pump() {
  if (busy) return; busy = true;
  while (queue.length) {
    const row = queue.shift();
    try { await upload(row); }
    catch (e) { paint(row, 0, 'fail'); row.el.querySelector('.info').textContent = e.message + ' (drop the file again to resume)'; }
  }
  busy = false; loadFiles();
}

function addFiles(list) {
  for (const f of list) queue.push(makeRow(f));
  pump();
}

const drop = $('#drop');
['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
drop.addEventListener('drop', e => addFiles(e.dataTransfer.files));
$('#pick').onclick = () => $('#file').click();
$('#file').onchange = e => { addFiles(e.target.files); e.target.value = ''; };
window.addEventListener('dragover', e => e.preventDefault());
window.addEventListener('drop', e => e.preventDefault());

// ---------- files on iPad ----------
async function loadFiles() {
  try {
    const r = await api('/api/files');
    if (r.status === 401) { await askPin(); return loadFiles(); }
    const list = await r.json();
    const box = $('#files');
    if (!list.length) { box.innerHTML = '<div class="card empty">No files on the iPad yet.</div>'; return; }
    box.innerHTML = list.map(f => {
      const ext = (f.name.split('.').pop() || '').toLowerCase(), has = f.name.includes('.');
      const href = '/files/' + encodeURIComponent(f.name) + (PIN ? '?pin=' + encodeURIComponent(PIN) : '');
      return '<div class="card file"><div class="grow"><div class="name">' + esc(f.name) + '</div>' +
        '<div class="row" style="margin-top:6px">' + (has ? '<span class="tag" style="--c:var(--' + extColor(ext) + ')">' + esc(ext.toUpperCase()) + '</span>' : '') +
        '<span class="info">' + fmtB(f.size) + '   ' + new Date(f.modified * 1000).toLocaleString() + '</span></div></div>' +
        '<a class="round red" href="' + href + '" download title="Download">&#8595;</a>' +
        '<button class="round" data-del="' + esc(f.name) + '" title="Delete from iPad">&#10005;</button></div>';
    }).join('');
  } catch (e) {}
}

$('#files').addEventListener('click', async e => {
  const b = e.target.closest('[data-del]'); if (!b) return;
  if (!confirm('Delete "' + b.dataset.del + '" from the iPad?')) return;
  await api('/api/files?' + qs({ name: b.dataset.del }), { method: 'DELETE' });
  loadFiles();
});
$('#refresh').onclick = loadFiles;

// ---------- connection ----------
let needPin = false;
async function ping() {
  try {
    const r = await (await fetch('/api/ping', { cache: 'no-store' })).json();
    setStatus(true, 'ONLINE');
    if (r.pin && !PIN && !needPin) { needPin = true; await askPin(); needPin = false; loadFiles(); }
  } catch (e) { setStatus(false, 'IPAD UNREACHABLE'); }
}
ping(); loadFiles();
setInterval(ping, 3000);
setInterval(() => { if (!busy) loadFiles(); }, 5000);
</script>
</body>
</html>
